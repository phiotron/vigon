<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Ví Gọn (AC-63, AC-64): dòng trạng thái (ẩn mặc định) và hai nút Chi, Thu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vigon_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_expense"
            android:contentDescription="@string/widget_expense_desc"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_expense"
            android:textColor="@color/widget_button_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_income"
            android:contentDescription="@string/widget_income_desc"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_income"
            android:textColor="@color/widget_button_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
