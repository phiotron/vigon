<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Ví Gọn 4×2 (EXT-01 4x2): thông tin bên trái (số 26 sp), hai nút xếp dọc bên phải rộng 132 dp.
     Vẽ lại theo mockup v4 EXT-01 (2026-11-10): nền ngọc widget-surface góc 24, chữ ngà; hai nút giấy
     brand-paper chữ brand-deep, màu thu/chi chỉ ở đĩa nhỏ − / +. Màu cố định trên hình nền sáng/tối.
     Trạng thái do VigonWidgetProvider đặt: mặc định · có số · khóa PIN · hết kỳ. Đây cũng là bản xem
     trước trong bộ chọn widget (trạng thái mặc định). Chỉ dùng class RemoteViews cho phép (KHÔNG
     thẻ Space, D9). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vigon_widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Hàng tiêu đề (brand-mint): logo + "Ví Gọn" (mặc định / hết kỳ), "Tháng này đã chi" (có số),
             khóa + "Đã khóa bằng PIN" (PIN). Chạm mở màn chính. -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="18dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_logo" />

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_label"
                android:textColor="@color/widget_mint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lời giới thiệu (mặc định) hoặc "Mở app để cập nhật" kèm icon cập nhật (hết kỳ). -->
        <LinearLayout
            android:id="@+id/widget_msg_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_msg_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_update"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_msg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/widget_description"
                android:textColor="@color/widget_ink_88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Số đã chi theo Tiền tệ chính (số lớn), hoặc "••••••" khi khóa PIN. -->
        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Thanh hạn mức: hai thanh (thường / cảnh báo) vì RemoteViews không đổi màu thanh được
             trước Android 12. -->
        <ProgressBar
            android:id="@+id/widget_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/vigon_widget_progress"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_bar_warn"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/vigon_widget_progress_warn"
            android:visibility="gone" />

        <!-- "trên Y · N%", hoặc ⚠ "Sắp vượt · N%" màu warning chữ đậm. -->
        <LinearLayout
            android:id="@+id/widget_caption_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_caption_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_warning"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textColor="@color/widget_ink_80"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_caption_warn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textColor="@color/widget_warning"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="14dp"
        android:layout_height="14dp" />

    <LinearLayout
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_action"
            android:contentDescription="@string/widget_expense_desc"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/vigon_widget_btn_expense"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_widget_minus" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_expense"
                android:textColor="@color/widget_deep"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Khoảng cách giữa hai nút. KHÔNG dùng thẻ Space (D9). -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp" />

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_action"
            android:contentDescription="@string/widget_income_desc"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/vigon_widget_btn_income"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_widget_plus" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_deep"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
