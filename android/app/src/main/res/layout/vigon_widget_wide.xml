<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Ví Gọn khi kéo rộng 4×2 (EXT-01 4x2): hai nút cạnh nhau, dòng trạng thái 1 dòng.
     Kiểu "Ngọc lục bảo & vàng" (widget B, 2026-11-06): nền ngà / ngọc lục bảo sâu theo sáng-tối của
     máy, viền vàng mảnh. Hàng trên: mặc định logo + "Ví Gọn" (không số); khi có dòng trạng thái thì
     hiện chữ đó màu vàng, kèm icon khóa (PIN) hoặc icon cập nhật (số kỳ cũ đã bỏ). Hai nút Chi/Thu:
     khối trong mờ, huy hiệu tròn −/+ và chữ, không chỉ dựa màu. Đây cũng là bản xem trước trong bộ
     chọn widget (trạng thái mặc định). Chỉ dùng class RemoteViews cho phép (KHÔNG <Space>, D9). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vigon_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_logo" />

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_label"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />

        <TextView android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_gold"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_action"
            android:contentDescription="@string/widget_expense_desc"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/vigon_widget_btn_expense"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_widget_minus" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_expense"
                android:textColor="@color/widget_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Khoảng cách giữa hai nút. KHÔNG dùng <Space>: RemoteViews không cho phép
             (launcher báo "Không thể thêm tiện ích", D9). -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp" />

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/vigon_widget_btn_action"
            android:contentDescription="@string/widget_income_desc"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/vigon_widget_btn_income"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_widget_plus" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
