<?xml version="1.0" encoding="utf-8"?>
<!-- Màu widget vẽ lại (mockup v4 EXT-01, token v3 widget-* / brand-*): màu thương hiệu CỐ ĐỊNH trên
     hình nền sáng lẫn tối — không theo chủ đề app, không theo màu động Android 12. -->
<resources>
    <!-- widget-surface = brand-deep -->
    <color name="widget_surface">#0E5244</color>
    <!-- widget-ink -->
    <color name="widget_ink">#F7FAF8</color>
    <!-- chữ phụ: widget-ink 88 % / 80 % -->
    <color name="widget_ink_88">#E0F7FAF8</color>
    <color name="widget_ink_80">#CCF7FAF8</color>
    <!-- số bị che khi khoá PIN: widget-ink 45 % -->
    <color name="widget_ink_45">#73F7FAF8</color>
    <!-- nền thanh hạn mức: widget-ink 18 % -->
    <color name="widget_track">#2EF7FAF8</color>
    <!-- brand-mint: tiêu đề, thanh hạn mức -->
    <color name="widget_mint">#8CD5BF</color>
    <!-- brand-paper / brand-deep: nút Chi/Thu -->
    <color name="widget_paper">#F7FAF8</color>
    <color name="widget_deep">#0E5244</color>
    <!-- warning (giá trị tối, đọc được trên nền ngọc): "Sắp vượt" ≥ 80 % -->
    <color name="widget_warning">#FFB869</color>
    <color name="widget_expense">#C62828</color>
    <color name="widget_income">#2E7D32</color>
    <color name="on_widget_action">#FFFFFF</color>
</resources>
