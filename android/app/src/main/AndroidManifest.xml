<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- D-025: INTERNET để tải bảng tỉ giá công khai (HTTPS) khi người dùng đổi tiền tệ;
         D-031: và đọc email biên lai qua IMAP/TLS (993) tới Gmail/Yahoo/iCloud khi người dùng thêm
         hộp thư. Không gửi dữ liệu người dùng cho nhà phát triển, không SDK, không analytics. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- F-25 nhắc ghi sổ: hai quyền này. Không báo thức chính xác. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Báo đúng phút (D-045): người dùng tự bật "Báo thức và lời nhắc";
         không bật thì lịch nhắc chạy kiểu xấp xỉ. KHÔNG dùng USE_EXACT_ALARM
         (Google Play chỉ cho app báo thức/lịch). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Plugin thông báo tự thêm VIBRATE; app không rung nên gỡ để khỏi thêm quyền ngoài danh sách. -->
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove"/>
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Mặc định Flutter 3.47 là BẬT (FlutterActivityLaunchConfigs.deepLinkEnabled
                 trả true khi thiếu khóa này): tắt để intent từ app ngoài không đẩy
                 đường dẫn tùy ý vào go_router. Nút widget và thông báo dùng DeepLinkChannel riêng. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- F-26: widget màn hình chính. Chỉ hệ thống gửi được lệnh cập nhật tới đây. -->
        <receiver
            android:name=".VigonWidgetProvider"
            android:label="@string/widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vigon_widget_info"/>
        </receiver>
        <!-- F-25: lịch nhắc hằng ngày của flutter_local_notifications; BootReceiver đặt lại lịch sau khi máy khởi động lại. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- F-24/D-026: sao lưu tự động theo giờ chọn khi app đóng. Báo thức KHÔNG chính xác
             (setAndAllowWhileIdle, không quyền báo thức chính xác) tới receiver này; receiver cũng đặt
             lại lịch sau khởi động lại, cập nhật app, đổi giờ, đổi múi giờ. Chỉ hệ thống gửi tới được. -->
        <receiver android:exported="false" android:name=".BackupAlarmReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Job chạy Dart nền (FlutterEngine không giao diện) để sao lưu; chỉ JobScheduler gọi được. -->
        <service
            android:name=".BackupJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <!-- F-28/AC-82: kiểm thư email nền ~mỗi giờ (job định kỳ, giữ qua khởi động lại nhờ
             RECEIVE_BOOT_COMPLETED đã có; không điều kiện mạng). Chỉ JobScheduler gọi được. -->
        <service
            android:name=".MailCheckJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Màn Giới thiệu mở trang chính sách bằng trình duyệt và soạn email báo lỗi (AC-41) qua app khác; link ghi công nguồn tỉ giá cũng mở bằng trình duyệt. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
