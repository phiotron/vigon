{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(dart format *)",
      "Bash(dart analyze*)",
      "Bash(flutter pub get)",
      "Bash(dart run build_runner build *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(eas submit *)",
      "Bash(npx eas-cli submit *)",
      "Bash(fastlane *)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Bash(flutter build *)",
      "Bash(flutter pub add *)",
      "Bash(flutter pub upgrade*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.*.local)",
      "Read(**/dart_defines.json)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.mobileprovision)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/key.properties)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.mobileprovision)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Edit(**/*.g.dart)",
      "Edit(**/*.freezed.dart)",
      "Edit(**/Pods/**)",
      "Edit(**/.dart_tool/**)"
    ]
  }
}
